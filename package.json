{
  "name": "codelens-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CodeLens AI - Understand any codebase in minutes, not days",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server && npx esbuild server/src/index.ts --bundle --platform=node --format=cjs --outfile=api/server.js --external:adm-zip --external:simple-git --external:multer",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "install:all": "npm install"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "simple-git": "^3.27.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
